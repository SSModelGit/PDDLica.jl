(define (domain cushing-adaptation)
  (:requirements :typing :numeric-fluents :components :processes :continuous-effects)
  (:component worker
    (:variables (mode) - object (progress) - number)
    (:methods
      (:method start :parameters () :precondition (= (mode) idle) :effect (assign (mode) active))
      (:method stop :parameters () :precondition (= (mode) active) :effect (assign (mode) done)))
    (:processes
      (:process work :parameters () :precondition (= (mode) active)
        :effect (increase (progress) (* #t 1))))))
