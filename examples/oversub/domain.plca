(define (domain oversub-adaptation)
  (:requirements :typing :numeric-fluents :components :processes :continuous-effects)
  (:component job
    (:variables (mode) - object (work) - number (rate) - number :static)
    (:methods
      (:method admit :parameters () :precondition (= (mode) waiting) :effect (assign (mode) running)))
    (:processes
      (:process execute :parameters () :precondition (= (mode) running)
        :effect (increase (work) (* #t (rate)))))))
