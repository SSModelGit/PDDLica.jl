(define (problem match-ac-demo)
  (:domain match-ac-adaptation)
  (:components (source - heat-source :present true) (load - heat-load :present true))
  (:connections (connect (port source) (port load)))
  (:init (= (source-temperature source) 100) (= (energy load) 0))
  (:goal (>= (energy load) 2)))
